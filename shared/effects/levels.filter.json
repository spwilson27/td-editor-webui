{
  "type": "levels",
  "group": "color",
  "doc": "Levels (the v2 adjustment, bit for bit): per straight colour channel t = clamp((c - inLow) / max(inHigh - inLow, 1e-4)), out = outLow + (outHigh - outLow) * t^(1/gamma) (gamma > 1 brightens mid-tones). sRGB encoded values, no linearisation; alpha unchanged.",
  "reads": "point",
  "preservesTransparent": true,
  "params": {
    "inLow": {"kind": "num", "default": 0, "min": 0, "max": 1},
    "inHigh": {"kind": "num", "default": 1, "min": 0, "max": 1},
    "gamma": {"kind": "num", "default": 1, "min": 0.1, "max": 10},
    "outLow": {"kind": "num", "default": 0, "min": 0, "max": 1},
    "outHigh": {"kind": "num", "default": 1, "min": 0, "max": 1}
  },
  "vars": [
    ["hi", "max(inHigh, inLow + 0.0001)"]
  ],
  "noop": "inLow == 0 && inHigh == 1 && gamma == 1 && outLow == 0 && outHigh == 1",
  "passes": [{"pass": 0, "u": ["inLow", "hi", "gamma", "outLow", "outHigh"]}],
  "extent": ["0", "0", "0", "0"],
  "samples": [{"inLow": 0.1, "inHigh": 0.9}, {"gamma": 2.2}, {"inLow": 0.2, "inHigh": 0.8, "gamma": 0.6, "outLow": 0.1, "outHigh": 0.95}, {"inLow": 1, "inHigh": 0}, {"outLow": 1, "outHigh": 0}],
  "degenerate": [{}, {"inLow": 0.5, "inHigh": 0.5}, {"inLow": 1, "inHigh": 1}, {"gamma": 0}, {"gamma": 1e9}, {"inLow": "x", "gamma": null}, {"outLow": -5, "outHigh": 5}]
}
